#!/usr/bin/env python3
"""omarchy-rgb - match your OpenRGB lighting to the Omarchy background or theme.

Called by the plugin's shell service on theme/background changes and by the
bar panel. Settings live in ~/.config/omarchy/rgb-sync.json.

  omarchy-rgb sync [--force]         Compute and apply the color (only on change unless --force)
  omarchy-rgb status                 Settings, last state and dependency check as JSON
  omarchy-rgb preview                Compute the color without applying it
  omarchy-rgb set <key> <value> ...  Change settings and re-sync (--no-sync to skip)
  omarchy-rgb device <id> <key> <value>
                                     Change one device (enabled, channelOrder, zones)
  omarchy-rgb on | off               Enable/disable syncing (off = LEDs black)
  omarchy-rgb detect                 Re-detect OpenRGB devices, keeping per-device settings
"""

import colorsys
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CURRENT = STATE_HOME / "omarchy/current"
CONFIG_FILE = CONFIG_HOME / "omarchy/rgb-sync.json"
STATE_FILE = STATE_HOME / "omarchy-rgb/state.json"
LOCK_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omarchy-rgb.lock"

SOURCES = ("wallpaper", "theme", "fixed")

DEFAULTS = {
    "enabled": True,
    "source": "wallpaper",      # wallpaper | theme | fixed
    "themeKey": "accent",       # key from colors.toml, or "keyboard" for keyboard.rgb
    "fixedColor": "#FF00AA",
    "saturation": 1.0,          # 0..1
    "brightness": 1.0,          # 0..1
    "topFraction": 0.55,        # only the top part of the wallpaper (sky) counts
    "fallbackHue": 330,         # degrees, used when no hue stands out (magenta)
    "mode": "direct",
    "timeout": 20,              # seconds per openrgb call
    "retries": 5,               # devices may not be ready right after login
    "retryDelay": 3,
    # Filled by device detection on first run. Per device:
    #   id           index from `openrgb -l`
    #   channelOrder fixes swapped channels, e.g. "RBG" when green and blue are swapped
    #   zones        [] = whole device, or zone indices like [2, 3]
    #   enabled      false = leave this device alone
    "devices": None,
}


class Failure(Exception):
    pass


def load_json(path, fallback):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return fallback


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(path)


def missing_dependencies():
    missing = []
    if not shutil.which("openrgb"):
        missing.append("openrgb")
    if not shutil.which("inotifywait"):
        missing.append("inotify-tools")
    try:
        import PIL  # noqa: F401
    except ImportError:
        missing.append("python-pillow")
    return missing


def detect_devices(existing=None):
    """Read devices from `openrgb -l`, keeping settings of devices we already know."""
    if not shutil.which("openrgb"):
        raise Failure("openrgb is not installed")
    try:
        out = subprocess.run(["openrgb", "-l"], capture_output=True, text=True, timeout=60).stdout
    except subprocess.TimeoutExpired:
        raise Failure("openrgb -l timed out")
    known = {d.get("name"): d for d in (existing or [])}
    devices = []
    for m in re.finditer(r"^(\d+): (.+)$", out, re.M):
        dev_id, name = int(m.group(1)), m.group(2).strip()
        dev = {"id": dev_id, "name": name, "channelOrder": "RGB", "zones": [], "enabled": True}
        dev.update({k: v for k, v in known.get(name, {}).items() if k != "id"})
        dev["id"] = dev_id
        devices.append(dev)
    if not devices:
        raise Failure("OpenRGB found no devices (check i2c/udev permissions)")
    return devices


def load_config(detect=True):
    cfg = dict(DEFAULTS)
    cfg.update(load_json(CONFIG_FILE, {}))
    if cfg["devices"] is None and detect:
        cfg["devices"] = detect_devices()
        write_json(CONFIG_FILE, cfg)
    elif not CONFIG_FILE.exists():
        write_json(CONFIG_FILE, cfg)
    return cfg


def clamp(x):
    return max(0.0, min(1.0, float(x)))


def norm_hex(value):
    m = re.search(r"#?([0-9A-Fa-f]{6})", str(value))
    return m.group(1).upper() if m else None


def hex_to_rgb(hx):
    return tuple(int(hx[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


def rgb_to_hex(r, g, b):
    return "".join(f"{int(round(c * 255)):02X}" for c in (r, g, b))


def from_hue(hue, cfg):
    return rgb_to_hex(*colorsys.hsv_to_rgb(hue, clamp(cfg["saturation"]), clamp(cfg["brightness"])))


def current_background(wait=0):
    link = CURRENT / "background"
    for _ in range(int(wait)):
        if link.exists():
            break
        time.sleep(1)
    return str(link.resolve()) if link.exists() else ""


def current_theme():
    try:
        return (CURRENT / "theme.name").read_text().strip()
    except OSError:
        return ""


def wallpaper_hue(path, top_frac):
    """Dominant hue in the top part of the image; None if the image is mostly gray."""
    try:
        from PIL import Image
    except ImportError:
        raise Failure("python-pillow is not installed (needed for the wallpaper source)")

    img = Image.open(path).convert("RGB")
    img.thumbnail((480, 480))
    w, h = img.size
    img = img.crop((0, 0, w, max(1, int(h * top_frac))))

    bins = [0] * 36
    pixels = img.get_flattened_data() if hasattr(img, "get_flattened_data") else img.getdata()
    for r, g, b in pixels:
        hh, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        # Skip dark and grayish pixels (silhouettes, white, gray)
        if v > 0.35 and s > 0.18:
            bins[int(hh * 36) % 36] += 1
    if max(bins) == 0:
        return None
    k = max(range(36), key=lambda i: bins[i])
    return (k + 0.5) / 36


def theme_color(key):
    theme_dir = CURRENT / "theme"
    try:
        if key == "keyboard":
            return norm_hex((theme_dir / "keyboard.rgb").read_text())
        for line in (theme_dir / "colors.toml").read_text().splitlines():
            m = re.match(rf'\s*{re.escape(key)}\s*=\s*"?#?([0-9A-Fa-f]{{6}})', line)
            if m:
                return m.group(1).upper()
    except OSError:
        pass
    return None


def theme_palette():
    """Colors of the current theme, offered as swatches in the panel."""
    out = []
    try:
        for line in (CURRENT / "theme/colors.toml").read_text().splitlines():
            m = re.match(r'\s*(accent|color\d+)\s*=\s*"?#?([0-9A-Fa-f]{6})', line)
            if m:
                out.append({"key": m.group(1), "color": "#" + m.group(2).upper()})
    except OSError:
        pass
    return out


def compute(cfg, wait=0):
    """Return (hex, description)."""
    source = cfg["source"]
    fallback = (cfg["fallbackHue"] % 360) / 360

    if source == "fixed":
        hx = norm_hex(cfg["fixedColor"]) or "FF00AA"
        h, s, v = colorsys.rgb_to_hsv(*hex_to_rgb(hx))
        return rgb_to_hex(*colorsys.hsv_to_rgb(h, s, v * clamp(cfg["brightness"]))), "fixed color"

    if source == "theme":
        hx = theme_color(cfg["themeKey"])
        if not hx:
            raise Failure(f"'{cfg['themeKey']}' not found in the current theme")
        h, s, _ = colorsys.rgb_to_hsv(*hex_to_rgb(hx))
        # A near-gray theme color has no stable hue
        return from_hue(h if s >= 0.08 else fallback, cfg), f"theme {current_theme()} ({cfg['themeKey']})"

    bg = current_background(wait)
    if not bg:
        raise Failure("background image not found")
    hue = wallpaper_hue(bg, float(cfg["topFraction"]))
    return from_hue(fallback if hue is None else hue, cfg), f"background {Path(bg).name}"


def reorder(hx, order):
    ch = dict(zip("RGB", (hx[0:2], hx[2:4], hx[4:6])))
    return "".join(ch[c] for c in order.upper())


def apply(hx, cfg):
    if not shutil.which("openrgb"):
        raise Failure("openrgb is not installed")
    # One openrgb call for all devices - the device scan is the slow part
    args = ["openrgb"]
    for dev in cfg["devices"] or []:
        if dev.get("enabled", True) is False:
            continue
        color = reorder(hx, dev.get("channelOrder", "RGB"))
        for zone in dev.get("zones") or [None]:
            args += ["-d", str(dev["id"])]
            if zone is not None:
                args += ["-z", str(zone)]
            args += ["-m", cfg["mode"], "-c", color]
    if len(args) == 1:
        return

    err = "openrgb failed"
    for _ in range(int(cfg["retries"])):
        try:
            r = subprocess.run(args, capture_output=True, text=True, timeout=cfg["timeout"])
            if r.returncode == 0:
                return
            lines = (r.stderr or r.stdout).strip().splitlines()
            err = lines[-1] if lines else err
        except subprocess.TimeoutExpired:
            err = f"openrgb hung (>{cfg['timeout']}s)"
        time.sleep(cfg["retryDelay"])
    raise Failure(err)


def signature(cfg):
    keys = ("enabled", "source", "themeKey", "fixedColor", "saturation", "brightness",
            "topFraction", "fallbackHue", "mode", "devices")
    return json.dumps([cfg[k] for k in keys] + [current_background(), current_theme()], sort_keys=True)


def save_state(**fields):
    state = load_json(STATE_FILE, {})
    state.update(fields, updated=datetime.now().isoformat(timespec="seconds"))
    write_json(STATE_FILE, state)


def cmd_sync(force=False, wait=30):
    with open(LOCK_FILE, "w") as lock:
        # Wait instead of bailing out, so a change made during a running sync is not lost
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cfg = load_config()
            sig = signature(cfg)
            state = load_json(STATE_FILE, {})
            if not force and state.get("signature") == sig and state.get("ok"):
                print(f"#{state.get('color', '')} (unchanged)")
                return 0
            hx, desc = compute(cfg, wait) if cfg["enabled"] else ("000000", "off")
            apply(hx, cfg)
        except Exception as e:  # noqa: BLE001 - errors are shown in the panel
            save_state(ok=False, error=str(e), signature="")
            print(f"error: {e}", file=sys.stderr)
            return 1
        save_state(ok=True, error="", color=hx, description=desc, source=cfg["source"],
                   enabled=cfg["enabled"], signature=sig)
        print(f"#{hx} - {desc}")
        return 0


def parse_value(key, raw, defaults=DEFAULTS):
    if key not in defaults:
        raise SystemExit(f"unknown setting: {key}")
    default = defaults[key]
    if isinstance(default, bool):
        return raw.lower() in ("1", "true", "on", "yes")
    if isinstance(default, float):
        return float(raw)
    if isinstance(default, int):
        return int(float(raw))
    if isinstance(default, list) or default is None:
        return json.loads(raw)
    if key == "source" and raw not in SOURCES:
        raise SystemExit(f"source must be one of: {', '.join(SOURCES)}")
    if key == "fixedColor":
        hx = norm_hex(raw)
        if not hx:
            raise SystemExit("fixedColor needs a hex color like #FF00AA")
        return "#" + hx
    if key == "channelOrder" and sorted(raw.upper()) != ["B", "G", "R"]:
        raise SystemExit("channelOrder must be a permutation of RGB, e.g. RBG")
    return raw.upper() if key == "channelOrder" else raw


def cmd_set(pairs, sync=True):
    if not pairs or len(pairs) % 2:
        raise SystemExit("usage: omarchy-rgb set <key> <value> [<key> <value> ...]")
    cfg = load_config(detect=False)
    for key, raw in zip(pairs[::2], pairs[1::2]):
        cfg[key] = parse_value(key, raw)
    write_json(CONFIG_FILE, cfg)
    return cmd_sync(wait=0) if sync else 0


DEVICE_KEYS = {"enabled": True, "channelOrder": "RGB", "zones": []}


def cmd_device(args):
    if len(args) != 3:
        raise SystemExit("usage: omarchy-rgb device <id> <key> <value>")
    dev_id, key, raw = int(args[0]), args[1], args[2]
    cfg = load_config()
    for dev in cfg["devices"]:
        if dev["id"] == dev_id:
            dev[key] = parse_value(key, raw, DEVICE_KEYS)
            break
    else:
        raise SystemExit(f"no device with id {dev_id}")
    write_json(CONFIG_FILE, cfg)
    return cmd_sync(wait=0)


def main(argv):
    cmd = argv[0] if argv else "sync"
    rest = argv[1:]
    try:
        if cmd == "sync":
            return cmd_sync(force="--force" in rest)
        if cmd == "status":
            print(json.dumps({"config": load_config(detect=False), "state": load_json(STATE_FILE, {}),
                              "theme": current_theme(), "background": current_background(),
                              "palette": theme_palette(), "missing": missing_dependencies()},
                             ensure_ascii=False))
            return 0
        if cmd == "preview":
            hx, desc = compute(load_config(detect=False))
            print(f"#{hx} - {desc}")
            return 0
        if cmd == "set":
            return cmd_set([a for a in rest if a != "--no-sync"], sync="--no-sync" not in rest)
        if cmd == "device":
            return cmd_device(rest)
        if cmd in ("on", "off"):
            return cmd_set(["enabled", "true" if cmd == "on" else "false"])
        if cmd == "detect":
            cfg = load_config(detect=False)
            cfg["devices"] = detect_devices(cfg["devices"])
            write_json(CONFIG_FILE, cfg)
            for d in cfg["devices"]:
                print(f"{d['id']}: {d['name']} ({d['channelOrder']}{'' if d['enabled'] else ', disabled'})")
            return 0
    except Failure as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
